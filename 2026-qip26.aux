\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Graphical representation of the two distinct coverings of the octagon hypergraph. \textbf  {(a)} Covering A (bold lines) isolates the $(a_1, a_2)$ pseudocontext using inner contexts $D_0, D_2$ and alternating outer edges. \textbf  {(b)} Covering B (bold lines) isolates the $(b_1, b_2)$ pseudocontext using inner contexts $D_1, D_3$ and the complementary outer edges. Vertices actively engaged in a covering are filled black, while the two strictly uncovered inner vertices in each panel are filled white. Since both coverings exactly partition all 16 outer vertices, their respective probability sums must equate, forcing $P(a_1)+P(a_2) = P(b_1)+P(b_2)$.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:octagon_coverings}{{2}{9}{Graphical representation of the two distinct coverings of the octagon hypergraph. \textbf {(a)} Covering A (bold lines) isolates the $(a_1, a_2)$ pseudocontext using inner contexts $D_0, D_2$ and alternating outer edges. \textbf {(b)} Covering B (bold lines) isolates the $(b_1, b_2)$ pseudocontext using inner contexts $D_1, D_3$ and the complementary outer edges. Vertices actively engaged in a covering are filled black, while the two strictly uncovered inner vertices in each panel are filled white. Since both coverings exactly partition all 16 outer vertices, their respective probability sums must equate, forcing $P(a_1)+P(a_2) = P(b_1)+P(b_2)$}{figure.2}{}}
