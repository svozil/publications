\frametitle{A single isolated context with two mutually exclusive observables}

\colorbox{yellow}{\textcolor{red}{Red entries}} are from the Travis matrix.



\begin{itemize}

\item[input]
$\;$ \\
{\tiny
${\tt mat = cdd.Matrix([}$\\
${\tt [ 1, \colorbox{yellow}{\textcolor{red}{1}} , \colorbox{yellow}{\textcolor{red}{0}} ],}$\\
${\tt [ 1, \colorbox{yellow}{\textcolor{red}{0}} , \colorbox{yellow}{\textcolor{red}{1}} ]])}$\\
${\tt poly = cdd.Polyhedron(mat)}$\\
${\tt ine = poly.get\_inequalities()}$\\
${\tt print(ine)}$
}

\item[output]
$\;$ \\
{\tiny
${\tt H-representation }$\\
${\tt linearity\; 1 \; 3 }$\\
${\tt begin     }$\\
${\tt \; 3\; 3\; rational }$\\
${\tt \; 1\; -1\; 0    } \Rightarrow  \lambda_- \le 1 $\\
${\tt \; 0\; 1\; 0    } \Rightarrow  -\lambda_- \le 0 \Rightarrow  \lambda_- \ge 0$\\
${\tt \; -1\; 1\; 1  } \Rightarrow  -\lambda_- - \lambda_+ \le -1 \Rightarrow  \lambda_- + \lambda_+ \ge 1$\\
${\tt end     }$
}

\end{itemize}


