\bibitem [{Note1()}]{Note1}%
  \BibitemOpen
  \bibinfo {note} {For ease of exposition we treat the set of contextual frames
  as discrete, indexed by sense. In a learning setting, frames could equally be
  parameterized continuously---e.g., as elements of the Stiefel manifold
  $V_{d-1}(\protect \mathbb {R}^d)$---in which case Eqs.~\protect \eqref
  {eq:sense-score}--\protect \eqref {eq:frame-selection} become a continuous
  optimization rather than a discrete argmax. The discrete formulation is
  natural for sense disambiguation, where senses are categorical in
  lexicography, and we use it throughout.}\BibitemShut {Stop}%
