\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textcolor {blue}{Comparison of the three representative correlation functions $E(\theta )$. The quantum (solid red) and classical benchmark (dashed green) only achieve perfect anti-correlation at $\theta =0$. The stronger-than-quantum correlation (dotted blue) is perfect for all angles except $\theta = \pi /2$.}}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:correlations}{{1}{4}{\textcolor {blue}{Comparison of the three representative correlation functions $E(\theta )$. The quantum (solid red) and classical benchmark (dashed green) only achieve perfect anti-correlation at $\theta =0$. The stronger-than-quantum correlation (dotted blue) is perfect for all angles except $\theta = \pi /2$.}}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textcolor {blue}{Mutual information versus measurement angle $\theta $. All three representative models achieve the maximum value $\ln 2$, but their robustness to misalignment differs. The classical benchmark (dashed green) degrades as $\Theta (\delta \theta \ln (1/\delta \theta ))$ from the peak, while the quantum cosine law (solid red) degrades as $\Theta (\delta \theta ^{2}\ln (1/\delta \theta ))$, offering superior resilience within the restricted comparison class.}}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:mutual_information}{{2}{4}{\textcolor {blue}{Mutual information versus measurement angle $\theta $. All three representative models achieve the maximum value $\ln 2$, but their robustness to misalignment differs. The classical benchmark (dashed green) degrades as $\Theta (\delta \theta \ln (1/\delta \theta ))$ from the peak, while the quantum cosine law (solid red) degrades as $\Theta (\delta \theta ^{2}\ln (1/\delta \theta ))$, offering superior resilience within the restricted comparison class.}}{figure.2}{}}
