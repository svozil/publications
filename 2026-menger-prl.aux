\newlabel{eq:aMplus}{{6}{2}{}{equation.6}{}}
\newlabel{eq:ahole}{{7}{2}{}{equation.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Archimedean repulsion. The substratum (wavy band) flows gravitationally toward $M_+$ with $\hat  {\mathbf  {n}}$ the unit vector from hole to $M_+$. The hole, as a buoyant absence in this flow, is displaced in the $-\hat  {\mathbf  {n}}$ direction, $\mathbf  {a}_{\text  {hole}}$ [Eq.~\eqref  {eq:ahole}]. Simultaneously, $M_+$ is gravitationally repelled along $+\hat  {\mathbf  {n}}$ by the hole's effective negative source, $\mathbf  {a}_{M_+}$ [Eq.~\eqref  {eq:aMplus}]. Both accelerations point away from the other body; the pair separates rather than running away in a common direction.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:archimedes}{{1}{2}{Archimedean repulsion. The substratum (wavy band) flows gravitationally toward $M_+$ with $\hat {\mathbf {n}}$ the unit vector from hole to $M_+$. The hole, as a buoyant absence in this flow, is displaced in the $-\hat {\mathbf {n}}$ direction, $\mathbf {a}_{\text {hole}}$ [Eq.~\eqref {eq:ahole}]. Simultaneously, $M_+$ is gravitationally repelled along $+\hat {\mathbf {n}}$ by the hole's effective negative source, $\mathbf {a}_{M_+}$ [Eq.~\eqref {eq:aMplus}]. Both accelerations point away from the other body; the pair separates rather than running away in a common direction}{figure.1}{}}
