           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
      "globalClasses"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nonZeroUniques", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"uniqueLabeledVectors", ",", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"ZeroVectorQ", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"numUniques", "=", 
     RowBox[{"Length", "[", "nonZeroUniques", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Building orthogonality graph for the great set...\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"orthoLists", "=", 
     RowBox[{"Monitor", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"v1", "=", 
           RowBox[{"nonZeroUniques", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", "numUniques"}], "]"}], ",", 
            RowBox[{
             RowBox[{"OrthogonalQ", "[", 
              RowBox[{"v1", ",", 
               RowBox[{"nonZeroUniques", "[", 
                RowBox[{"[", 
                 RowBox[{"#", ",", "2"}], "]"}], "]"}]}], "]"}], "&"}]}], 
           "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "numUniques"}], "}"}]}], "]"}], ",", 
       RowBox[{"\"\<Processing vector \>\"", "<>", 
        RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\</\>\"", "<>", 
        RowBox[{"ToString", "[", "numUniques", "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<Graph built. Searching for all orthogonal bases...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"allOrthBases", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "result", "}"}], ",", 
       RowBox[{
        RowBox[{"result", "=", 
         RowBox[{"Last", "@", 
          RowBox[{"Reap", "[", 
           RowBox[{"Monitor", "[", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"Module", "[", 
                RowBox[{
                 RowBox[{"{", "neighborsOfI", "}"}], ",", 
                 RowBox[{
                  RowBox[{"neighborsOfI", "=", 
                   RowBox[{"orthoLists", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "neighborsOfI", "]"}], "<", "2"}], 
                    ",", 
                    RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"Do", "[", 
                   RowBox[{
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "j", ",", "neighborsOfJ", ",", "commonNeighborsK"}], 
                    "}"}], ",", 
                    RowBox[{
                    RowBox[{"j", "=", 
                    RowBox[{"neighborsOfI", "[", 
                    RowBox[{"[", "jIdx", "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"neighborsOfJ", "=", 
                    RowBox[{"orthoLists", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"commonNeighborsK", "=", 
                    RowBox[{"Intersection", "[", 
                    RowBox[{"neighborsOfI", ",", "neighborsOfJ"}], "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"nonZeroUniques", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"nonZeroUniques", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", 
                    RowBox[{"nonZeroUniques", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "commonNeighborsK"}], "}"}]}], 
                    "]"}]}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"jIdx", ",", "1", ",", 
                    RowBox[{"Length", "[", "neighborsOfI", "]"}]}], "}"}]}], 
                   "]"}]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "numUniques"}], "}"}]}], "]"}], 
             ",", 
             RowBox[{"\"\<Searching for bases starting with vector \>\"", "<>", 
              RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\</\>\"", "<>", 
              RowBox[{"ToString", "[", "numUniques", "]"}]}]}], "]"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"result", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"{", "}"}], ",", 
          RowBox[{"First", "[", "result", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "allOrthBases", "]"}], ",", 
      "\"\< total orthogonal bases.\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "Second"}]}]}]}]}], ",", 
     RowBox[{"classify", " ", "these", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"bases", "--"}], "--"}], "--"}], "--"}], "--"}]}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Classifying bases into subgroups...\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Helper", " ", "to", " ", "get", " ", "the", " ", "originating", " ", 
       "u"}], "-", 
      RowBox[{
      "index", " ", "from", " ", "a", " ", "label", " ", "like", " ", 
       "\"\<a_2[5]\>\""}]}], "->", "5"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getOriginIndex", "[", "label_String", "]"}], ":=", 
     RowBox[{"ToExpression", "@", 
      RowBox[{
       RowBox[{"StringCases", "[", 
        RowBox[{"label", ",", 
         RowBox[{
          RowBox[{"\"\<[\>\"", "~~", "i__", "~~", "\"\<]\>\""}], ":>", 
          "i"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"group1Indices", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"group2Indices", "=", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5", ",", "6"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"group3Indices", "=", 
     RowBox[{"{", 
      RowBox[{"7", ",", "8", ",", "9"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Partition", " ", "the", " ", "bases", " ", "into", " ", "the", " ", 
     "three", " ", "specified", " ", "classes"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"basesU123", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"allOrthBases", ",", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"group1Indices", ",", 
             RowBox[{"getOriginIndex", "[", "#", "]"}]}], "]"}], "&"}]}], 
         "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"basesU456", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"allOrthBases", ",", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"group2Indices", ",", 
             RowBox[{"getOriginIndex", "[", "#", "]"}]}], "]"}], "&"}]}], 
         "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"basesU789", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"allOrthBases", ",", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"group3Indices", ",", 
             RowBox[{"getOriginIndex", "[", "#", "]"}]}], "]"}], "&"}]}], 
         "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mixedBases", "=", 
     RowBox[{"Complement", "[", 
      RowBox[{
      "allOrthBases", ",", "basesU123", ",", "basesU456", ",", "basesU789"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Classification complete:\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Bases solely from u1,u2,u3: \>\"", ",", 
      RowBox[{"Length", "[", "basesU123", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Bases solely from u4,u5,u6: \>\"", ",", 
      RowBox[{"Length", "[", "basesU456", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Bases solely from u7,u8,u9: \>\"", ",", 
      RowBox[{"Length", "[", "basesU789", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Mixed-origin bases: \>\"", ",", 
      RowBox[{"Length", "[", "mixedBases", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "Third"}]}]}]}]}], ",", 
     RowBox[{
      RowBox[{"generate", " ", "the", " ", "color"}], "-", 
      RowBox[{"coded", " ", "LaTeX", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"output", "--"}], "--"}], "--"}], "--"}], "--"}]}]}]}], 
    "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Helper", " ", "to", " ", "format", " ", "a", " ", "label", " ", "like", 
     " ", "\"\<a_2[1]\>\"", " ", "into", " ", "LaTeX", " ", 
     "\"\<a_{21}\>\""}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"formatLabelAsTeX", "[", "str_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"name", ",", "subscript", ",", "index"}], "}"}], ",", 
       RowBox[{
        RowBox[{"name", "=", 
         RowBox[{
          RowBox[{"StringSplit", "[", 
           RowBox[{"str", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<_\>\"", ",", "\"\<[\>\""}], "}"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"index", "=", 
         RowBox[{
          RowBox[{"StringCases", "[", 
           RowBox[{"str", ",", 
            RowBox[{
             RowBox[{"\"\<[\>\"", "~~", "i__", "~~", "\"\<]\>\""}], ":>", 
             "i"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"subscript", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"str", ",", "\"\<_\>\""}], "]"}], ",", 
           RowBox[{"StringDelete", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"StringCases", "[", 
               RowBox[{"str", ",", 
                RowBox[{
                 RowBox[{"\"\<_\>\"", "~~", "s__", "~~", "\"\<[\>\""}], ":>", 
                 "s"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<{\>\"", ",", "\"\<}\>\""}], "}"}]}], "]"}], ",", 
           "\"\<\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"StringJoin", "[", 
         RowBox[{
         "\"\<$\>\"", ",", "name", ",", "\"\<_{\>\"", ",", "subscript", ",", 
          "index", ",", "\"\<}$\>\""}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Main", " ", "function", " ", "to", " ", "generate", " ", "the", " ", 
      "color"}], "-", 
     RowBox[{
     "coded", " ", "LaTeX", " ", "table", " ", "row", " ", "for", " ", "a", 
      " ", "basis"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makeColoredRow", "[", "basis_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "color", "}"}], ",", 
       RowBox[{
        RowBox[{"color", "=", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"basesU123", ",", "basis"}], "]"}], ",", "\"\<red\>\"", 
           ",", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"basesU456", ",", "basis"}], "]"}], ",", "\"\<green\>\"", 
           ",", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"basesU789", ",", "basis"}], "]"}], ",", "\"\<blue\>\"", 
           ",", "True", ",", "\"\<black\>\""}], " ", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Should", " ", "not", " ", "happen", " ", "if", " ", "only", " ", 
             "pure", " ", "bases", " ", "are", " ", "passed"}], ",", 
            RowBox[{"but", " ", "good", " ", "for", " ", "safety"}]}], "*)"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
            "\"\<\\\\textcolor{\>\"", "<>", "color", "<>", "\"\<}{\>\"", "<>", 
             RowBox[{"formatLabelAsTeX", "[", 
              RowBox[{"basis", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
             "\"\<}\>\""}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "\"\<, \>\""}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "will", " ", "only", " ", "include", " ", "the", " ", "PURE", 
     " ", "bases", " ", "in", " ", "the", " ", "final", " ", "table", " ", 
     "as", " ", "per", " ", "the", " ", "prompt"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pureBases", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"basesU123", ",", "basesU456", ",", "basesU789"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"latexTablePureBases", ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"header", ",", "bodyRows"}], "}"}], ",", 
       RowBox[{
        RowBox[{"header", "=", 
         RowBox[{
         "{", "\"\<Orthogonal Bases from Pure Subgroups (u1-3, u4-6, \
u7-9)\>\"", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bodyRows", "=", 
         RowBox[{"makeColoredRow", "/@", "pureBases"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "\"\<\\\\documentclass{article}\\n\\\\usepackage{xcolor}\\n\\\\begin{\
document}\\n\>\"", "<>", "\"\<\\\\begin{tabular}{|c|}\\n\\\\hline\\n\>\"", 
         "<>", "\"\<\\\\textbf{\>\"", "<>", 
         RowBox[{"header", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<>", 
         "\"\<} \\\\\\\\ \\\\hline\\n\>\"", "<>", 
         RowBox[{"StringRiffle", "[", 
          RowBox[{"bodyRows", ",", "\"\< \\\\\\\\ \\\\hline\\n\>\""}], "]"}], 
         "<>", "\"\<\\n\>\"", "<>", 
         "\"\<\\\\end{tabular}\\n\\\\end{document}\>\""}]}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Export", " ", "and", " ", "print", " ", "the", " ", "LaTeX", " ", 
     "source"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"outputDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"$TemporaryDirectory", ",", "\"\<mathematica_output\>\""}], 
       "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", "outputDir", "]"}]}], ",", 
      RowBox[{"CreateDirectory", "[", "outputDir", "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"outputFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"outputDir", ",", "\"\<colored_bases_table.tex\>\""}], "}"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nExporting LaTeX file to \>\"", ",", "outputFile"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"outputFile", ",", "latexTablePureBases", ",", "\"\<Text\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Done exporting.\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"StringRepeat", "[", 
      RowBox[{"\"\<-\>\"", ",", "60"}], "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Style", "[", 
      RowBox[{
      "\"\<LaTeX Source for Color-Coded Table of Pure Orthogonal Bases:\>\"", 
       ",", "Bold"}], "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "latexTablePureBases", "]"}], ";"}]}]}]], "Input",
