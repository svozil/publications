\@writefile{toc}{\contentsline {subsection}{\numberline {B}The Lever Analogy}{5}{section*.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Schematic of the lever analogy. (a) For downwind motion, the pivot is at one end. The wind pushes the sail (at distance $d_s$), causing the far end (at $L$) to move faster than the wind. (b) For upwind motion, the pivot lies between the sail and the observation point, causing the far end to move in the opposite direction of the wind's push.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:lever-downupwind}{{3}{6}{Schematic of the lever analogy. (a) For downwind motion, the pivot is at one end. The wind pushes the sail (at distance $d_s$), causing the far end (at $L$) to move faster than the wind. (b) For upwind motion, the pivot lies between the sail and the observation point, causing the far end to move in the opposite direction of the wind's push}{figure.3}{}}
